# OpenVPN Client for RHTLC
# Connect via: sudo openvpn --config rhtlc-vpn.ovpn
# Windows: Use OpenVPN GUI - right-click tray icon → Connect

client
dev tun
proto tcp

remote workstation.lab.example.com 1194
socks-proxy 127.0.0.1 1080

resolv-retry infinite
nobind
persist-key
persist-tun

remote-cert-tls server
cipher AES-256-GCM
auth SHA256
key-direction 1

tun-mtu 1300
mssfix 1260

verb 3

# DNS Configuration
# Server pushes DNS automatically (172.25.250.254)
# Windows: Automatically configured by OpenVPN service
# Linux/macOS: Use openvpn-dns-helper.sh script for additional configuration

# Windows-specific: Ensure DNS is set when VPN connects
# This works with OpenVPN Community Edition GUI
script-security 2

# Optional: Uncomment to prevent DNS leaks on Windows
# block-outside-dns

